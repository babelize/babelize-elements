{
  "name": "@babelize/elements",
  "version": "0.1.0",
  "description": "Open-source copy-paste Localization UI components for React and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsc --project tsconfig.lib.json",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/babelize/babelize-elements.git"
  },
  "keywords": [
    "react",
    "i18n",
    "localization",
    "internationalization",
    "tailwindcss",
    "components",
    "language-switcher",
    "locale-picker",
    "rtl",
    "nextjs"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
