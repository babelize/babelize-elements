{
  "name": "@babelize/elements",
  "version": "2.0.1",
  "description": "Open-source Localization UI components for React and Tailwind CSS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "elements": "./bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "rm -rf dist && tsup",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "fumadocs-mdx && tsc --noEmit && tsc --project tsconfig.lib.json --noEmit",
    "prepublishOnly": "bun run build:lib",
    "test": "vitest run && npm run test:registry",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:pack": "node scripts/smoke-pack.mjs",
    "test:registry": "node scripts/check-registry-imports.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/babelize/babelize-elements.git"
  },
  "keywords": [
    "react",
    "i18n",
    "localization",
    "internationalization",
    "tailwindcss",
    "components",
    "language-switcher",
    "locale-picker",
    "rtl",
    "nextjs"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.0",
    "jsdom": "^30.0.1",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
