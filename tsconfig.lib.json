{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/registry/components/**/*.ts",
    "src/registry/components/**/*.tsx",
    "src/lib/utils.ts",
    "src/lib/use-controllable-state.ts",
    "src/cli/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app", "src/components", ".next", ".source"]
}
